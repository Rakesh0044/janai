# Base URL of the JanDrishti Python backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to force the UI into demo mode (synthetic data) even if a backend is configured
NEXT_PUBLIC_FORCE_DEMO_MODE=false
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=your_model_name
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# SQLite database location. Defaults to ./janai.db beside main.py.
JANAI_DB_PATH=./janai.db

# Comma-separated frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:3000
